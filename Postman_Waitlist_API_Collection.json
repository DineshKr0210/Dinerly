      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"phone\": \"+1-416-555-0123\",\n  \"partySize\": 4,\n  \"preference\": \"Window\",\n  \"notes\": \"Allergic to nuts\",\n  \"position\": 1,\n  \"estimatedWaitTime\": 15\n}",
          "options": {"raw": {"language": "json"}}
        },
