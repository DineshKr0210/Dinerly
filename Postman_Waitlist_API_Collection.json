      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {"raw": "{{base_url}}/api/restaurants/{{restaurantId}}/waitlist", "host": ["{{base_url}}"], "path": ["api", "restaurants", "{{restaurantId}}", "waitlist"]}
      },
      "response": []
    },
    {
