        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {"raw": "{{base_url}}/api/restaurants/{{restaurantId}}/waitlist/{{waitlistId}}", "host": ["{{base_url}}"], "path": ["api", "restaurants", "{{restaurantId}}", "waitlist", "{{waitlistId}}"]}
      },
      "response": []
    },
    {
      "name": "Join Waitlist (public)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"restaurantId\": {{restaurantId}},\n  \"name\": \"Jane Smith\",\n  \"phone\": \"+1-416-555-0144\",\n  \"partySize\": 2,\n  \"preference\": \"Booth\",\n  \"notes\": \"Vegan\"\n}", "options": {"raw": {"language": "json"}}},
        "url": {"raw": "{{base_url}}/api/waitlist", "host": ["{{base_url}}"], "path": ["api", "waitlist"]}
      },
      "response": []
    },
    {
      "name": "Get Waitlist Status (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{base_url}}/api/waitlist/status?restaurantId={{restaurantId}}&phone={{phone}}", "host": ["{{base_url}}"], "path": ["api", "waitlist", "status"], "query": [{"key": "restaurantId", "value": "{{restaurantId}}"}, {"key": "phone", "value": "{{phone}}"}]}
      },
      "response": []
    },
    {
      "name": "Leave Waitlist (public)",
      "request": {
        "method": "DELETE",
        "header": [],
