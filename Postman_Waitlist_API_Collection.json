          "mode": "raw",
          "raw": "{\n  \"name\": \"thecommons\",\n  \"address\": \"Canada\",\n  \"phone\": \"+1-647-555-0101\",\n  \"email\": \"thecommons@restaurant.com\",\n  \"totalTables\": 20\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {"raw": "{{base_url}}/api/restaurants", "host": ["{{base_url}}"], "path": ["api", "restaurants"]}
      },
      "response": []
