        "url": {"raw": "{{base_url}}/api/restaurants/{{restaurantId}}/waitlist/{{waitlistId}}/notify", "host": ["{{base_url}}"], "path": ["api", "restaurants", "{{restaurantId}}", "waitlist", "{{waitlistId}}", "notify"]}
