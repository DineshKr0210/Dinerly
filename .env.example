# Waitlist Management System - Environment Configuration Template
# Copy this file to .env and update with your actual values

# ============================================
# Server Configuration
# ============================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ============================================
# Database Configuration
# ============================================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/waitlist_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=waitlist_user
SPRING_DATASOURCE_PASSWORD=waitlist_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# ============================================
# JPA/Hibernate Configuration
# ============================================
# Options: create, create-drop, validate, update
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect

# ============================================
# Twilio SMS Configuration
# ============================================
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# Java Options
# ============================================
JAVA_OPTS=-Xms256m -Xmx512m

# ============================================
# MySQL Docker Configuration
# ============================================
MYSQL_ROOT_PASSWORD=rootpassword123
MYSQL_DATABASE=waitlist_db
MYSQL_USER=waitlist_user
MYSQL_PASSWORD=waitlist_password

# ============================================
# phpMyAdmin Configuration (Optional)
# ============================================
PMA_HOST=database
PMA_USER=waitlist_user
PMA_PASSWORD=waitlist_password
PMA_PORT=3306

