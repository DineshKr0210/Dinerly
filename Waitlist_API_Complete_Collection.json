            "description": "Add a new table to the restaurant."
          }
        },
        {
          "name": "Update Table Status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/restaurants/{{restaurantId}}/tables/{{tableId}}/status?status=OCCUPIED",
              "host": ["{{base_url}}"],
              "path": ["restaurants", "{{restaurantId}}", "tables", "{{tableId}}", "status"],
              "query": [
                {
                  "key": "status",
                  "value": "OCCUPIED",
                  "description": "OPEN, OCCUPIED, RESERVED, NEEDS_CLEANING"
                }
              ]
            },
            "description": "Update table status. Options: OPEN, OCCUPIED, RESERVED, NEEDS_CLEANING"
          }
        },
