{
  "info": {
    "_postman_id": "waitlist-api-complete-collection",
    "name": "Waitlist Management System - Complete API",
    "description": "Complete REST API collection for Restaurant Waitlist Management System with Restaurant ID scoping. Organized by Login, Guest, Restaurant, Admin, and Utilities.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT Bearer Token - Set from login response"
    },
    {
      "key": "restaurantId",
      "value": "1",
      "type": "string",
      "description": "Restaurant ID (from create restaurant response or 1-4 for seeded restaurants)"
    },
    {
      "key": "waitlistId",
      "value": "1",
      "type": "string",
      "description": "Waitlist Entry ID (from join/add guest response)"
    },
    {
      "key": "tableId",
      "value": "1",
      "type": "string",
      "description": "Table ID (from get tables response)"
    },
    {
      "key": "phone",
      "value": "+1-416-555-0144",
      "type": "string",
      "description": "Guest phone number for status queries"
    }
  ],
  "item": [
    {
      "name": "🏥 Health Check (No Auth)",
      "description": "Public health check endpoint",
      "item": [
        {
          "name": "Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Check if application is running. No authentication required."
          }
        }
      ]
    },
    {
      "name": "🔐 Authentication",
      "description": "Login and password reset operations",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"restaurant@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "User login endpoint. Returns JWT token.\n\nNote: Copy the token from response and set it in the 'token' collection variable."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"restaurant@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password"]
            },
            "description": "Request password reset. Email will be sent with reset token."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"reset-token-from-email\",\n  \"newPassword\": \"newpassword123\",\n  \"confirmPassword\": \"newpassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "Reset password using token from email."
          }
        }
      ]
    },
    {
      "name": "👤 Guest Operations",
      "description": "Public guest-facing endpoints for joining waitlist and checking status",
      "item": [
        {
          "name": "Join Waitlist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": 1,\n  \"name\": \"Jane Smith\",\n  \"phone\": \"+1-416-555-0144\",\n  \"partySize\": 4,\n  \"preference\": \"Window Seat\",\n  \"notes\": \"Vegetarian guests\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/waitlist",
              "host": ["{{base_url}}"],
              "path": ["waitlist"]
            },
            "description": "Guest joins the waitlist. Status starts as PENDING until restaurant approves."
          }
        },
        {
          "name": "Get Waitlist Status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": 1,\n  \"phone\": \"+1-416-555-0144\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/waitlist/status",
              "host": ["{{base_url}}"],
              "path": ["waitlist", "status"]
            },
            "description": "Get all waitlist records for a phone number at a specific restaurant. Returns all matching records (today and previous days)."
          }
        },
        {
          "name": "Leave Waitlist",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/waitlist/{{restaurantId}}/{{waitlistId}}",
              "host": ["{{base_url}}"],
              "path": ["waitlist", "{{restaurantId}}", "{{waitlistId}}"]
            },
            "description": "Guest leaves/cancels from waitlist."
          }
        },
