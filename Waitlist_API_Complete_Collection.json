              "host": ["{{base_url}}"],
              "path": ["restaurants", "{{restaurantId}}", "waitlist", "{{waitlistId}}", "seat"]
            },
            "description": "Mark guest as seated. Status changes to SEATED and confirmation SMS is sent."
          }
        },
