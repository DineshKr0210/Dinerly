            "url": {
              "raw": "{{base_url}}/restaurants/{{restaurantId}}/waitlist/{{waitlistId}}",
              "host": ["{{base_url}}"],
              "path": ["restaurants", "{{restaurantId}}", "waitlist", "{{waitlistId}}"]
