              }
            },
            "url": {
              "raw": "{{base_url}}/restaurants/{{restaurantId}}/settings",
              "host": ["{{base_url}}"],
              "path": ["restaurants", "{{restaurantId}}", "settings"]
            },
            "description": "Update restaurant settings."
