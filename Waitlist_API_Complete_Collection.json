    {
      "name": "🏢 Restaurant Operations (with Restaurant ID)",
      "description": "Restaurant staff operations scoped to specific restaurant",
      "item": [
        {
          "name": "Get Restaurant Waitlist",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/restaurants/{{restaurantId}}/waitlist",
              "host": ["{{base_url}}"],
              "path": ["restaurants", "{{restaurantId}}", "waitlist"]
            },
            "description": "Get all guests in waitlist for the specified restaurant."
          }
        },
        {
          "name": "Add Guest to Waitlist (Restaurant Staff)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"phone\": \"+1-416-555-0123\",\n  \"partySize\": 4,\n  \"preference\": \"Window Seat\",\n  \"notes\": \"Allergic to nuts\",\n  \"position\": 2,\n  \"estimatedWaitTime\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/restaurants/{{restaurantId}}/waitlist",
              "host": ["{{base_url}}"],
              "path": ["restaurants", "{{restaurantId}}", "waitlist"]
            },
            "description": "Restaurant staff manually add a guest to the waitlist with position and estimated wait time."
          }
        },
        {
          "name": "Notify Guest (Send SMS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estimatedWaitTime\": 15,\n  \"position\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/restaurants/{{restaurantId}}/waitlist/{{waitlistId}}/notify",
              "host": ["{{base_url}}"],
              "path": ["restaurants", "{{restaurantId}}", "waitlist", "{{waitlistId}}", "notify"]
            },
            "description": "Send SMS notification to guest with optional estimated wait time and position updates. Status changes to NOTIFIED."
          }
        },
        {
          "name": "Seat Guest",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
