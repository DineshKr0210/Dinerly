# Production Environment Configuration Template
# Copy this to your production server and update with actual values
# DO NOT store this file in version control

# =============================
# Server Configuration
# =============================
SERVER_PORT=8080

# =============================
# Database Configuration - PRODUCTION ONLY
# =============================
# Use managed database service credentials (AWS RDS, Google Cloud SQL, Azure Database, etc.)
DB_URL=jdbc:postgresql://your-prod-db-host:5432/your_db_name?sslmode=require
DB_USERNAME=prod_db_user
DB_PASSWORD=your_very_secure_database_password_here_minimum_32_chars

# =============================
# JWT Configuration - PRODUCTION ONLY
# =============================
# Generate using: openssl rand -base64 64
JWT_SECRET=your_production_jwt_secret_key_minimum_64_characters_long_and_random_generated
JWT_EXPIRATION=86400000

# =============================
# Email Configuration - PRODUCTION ONLY
# =============================
# Use SendGrid, AWS SES, or similar production-grade email service
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key_here

# =============================
# Twilio SMS Configuration - PRODUCTION ONLY
# =============================
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_production_account_sid
TWILIO_AUTH_TOKEN=your_production_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =============================
# Logging Configuration - PRODUCTION
# =============================
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO

# =============================
# Additional Production Recommendations
# =============================
# 1. Use AWS Secrets Manager, Azure Key Vault, or Google Cloud Secret Manager
# 2. Enable SSL/TLS for all database connections
# 3. Set strong random values for JWT_SECRET (minimum 64 chars)
# 4. Use managed email services (SendGrid, AWS SES, etc.)
# 5. Store credentials in environment variables, not config files
# 6. Rotate credentials regularly
# 7. Use database read replicas for high availability
# 8. Enable database backups and point-in-time recovery
# 9. Monitor logs using CloudWatch, Datadog, or similar
# 10. Use VPN/private networks for database connections

